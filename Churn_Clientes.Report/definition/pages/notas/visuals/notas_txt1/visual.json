                      "fontSize": "5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Algunos user_id llegaron dañados por una planilla (ceros iniciales perdidos o notación científica, como 4.11E+08). Dos clientes comparten uno de esos valores.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "El listado de campañas tiene 1.384 usuarios: 840 se vinculan con clientes del sistema A y 544 no.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Las provincias venían en 31 variantes y se unificaron en 24 jurisdicciones; las ciudades se corrigieron con tildes.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "La facturación y los minutos son del trimestre: para las bajas incluyen un mes sin plan, así que compararlas con los activos tiene ese sesgo.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "5pt",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Los grupos chicos dan tasas inestables (Tierra del Fuego: 2 bajas en 47 clientes): conviene leerlas junto con la cantidad de bajas.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
                    }
                  }
                ]
