                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Una fila sin número de cliente quedó fuera del análisis: 10.901 filas, 10.900 clientes.",
                    "textStyle": {
                      "fontSize": "11.5pt",
                      "color": "#E6E0F0"
